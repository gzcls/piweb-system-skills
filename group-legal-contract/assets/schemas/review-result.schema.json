{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://group-legal.internal/schemas/review-result.schema.json",
  "title": "ContractReviewResult",
  "description": "集团法务合同合规审查结构化输出（供归档或对接 OA/CLM 系统）",
  "type": "object",
  "required": [
    "contract_name",
    "our_position",
    "contract_type",
    "kb_snapshot",
    "overall_risk",
    "top_risks",
    "issues",
    "missing_clauses",
    "pre_signing_checks",
    "checklist_coverage"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "description": "待审合同名称"
    },
    "our_position": {
      "type": "string",
      "description": "我方合同地位与交易角色（如：甲方/买方、乙方/承包方）"
    },
    "contract_type": {
      "type": "string",
      "description": "识别出的合同类型代码或名称"
    },
    "sector": {
      "type": ["string", "null"],
      "description": "所属集团业务板块（如：01_地产建筑板块）"
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "审查时采用的默认假设清单"
    },
    "kb_snapshot": {
      "type": "string",
      "description": "知识库快照日期与提交号"
    },
    "overall_risk": {
      "type": "string",
      "enum": ["高", "中", "低"],
      "description": "合同综合风险评级"
    },
    "signing_recommendation": {
      "type": "string",
      "enum": ["不建议直接签署（须重大修改）", "修改核心条款后可签署", "微调文字后即可签署"],
      "description": "签署结论建议"
    },
    "top_risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" }
        }
      },
      "description": "Top 核心商业与法律红线隐患摘要"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "clause_ref", "risk", "original_excerpt", "issue_analysis", "suggested_text", "legal_basis", "fallback"],
        "properties": {
          "id": { "type": "string", "pattern": "^R-\\d+$" },
          "block_id": { "type": "string" },
          "clause_ref": { "type": "string" },
          "risk": { "type": "string", "enum": ["高", "中", "低"] },
          "original_excerpt": { "type": "string" },
          "issue_analysis": { "type": "string" },
          "suggested_text": { "type": "string" },
          "legal_basis": {
            "type": "array",
            "items": { "type": "string" }
          },
          "legal_basis_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["citation", "evidence_type", "source_status"],
              "properties": {
                "citation": { "type": "string" },
                "law_id": { "type": ["string", "null"] },
                "law_title": { "type": ["string", "null"] },
                "law_query": { "type": ["string", "null"] },
                "article_labels": { "type": "array", "items": { "type": "string" } },
                "source_path": { "type": ["string", "null"] },
                "source_sha256": { "type": ["string", "null"] },
                "evidence_type": { "type": "string", "enum": ["law_citation"] },
                "source_status": { "type": "string", "enum": ["located", "manual_confirmation", "ambiguous"] }
              }
            }
          },
          "fallback": { "type": "string" }
          ,"evidence": {
            "type": "object",
            "required": ["source_block_id", "evidence_type", "source_status"],
            "properties": {
              "source_block_id": { "type": "string" },
              "quote": { "type": "string" },
              "span_start": { "type": ["integer", "null"], "minimum": 0 },
              "span_end": { "type": ["integer", "null"], "minimum": 0 },
              "quote_sha256": { "type": ["string", "null"] },
              "evidence_type": { "type": "string", "enum": ["contract_text", "law_citation", "business_confirmation", "manual"] },
              "source_status": { "type": "string", "enum": ["located", "manual_confirmation"] }
            }
          }
        }
      }
    },
    "missing_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "reason", "suggested_clause_text"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string" },
          "suggested_clause_text": { "type": "string" },
          "legal_basis": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "pre_signing_checks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "签约前商务与合规核查事项清单"
    },
    "checklist_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checklist_id", "checklist_title", "status"],
        "properties": {
          "checklist_id": { "type": "string" },
          "checklist_title": { "type": "string" },
          "status": { "type": "string", "enum": ["已全项核查", "部分适用", "不适用", "待人工确认"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
