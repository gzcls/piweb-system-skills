{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/pptx-theme-config.json",
  "title": "Huaxin PPT theme configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "theme", "canvas", "design_canvas",
    "runtime_scale", "safe_area", "grid", "spacing", "density",
    "components", "typography", "fonts", "colors", "charts", "images",
    "bg_rules", "footer", "slides"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 2 },
    "theme": { "type": "string", "minLength": 1 },
    "canvas": { "$ref": "#/$defs/canvas" },
    "design_canvas": { "$ref": "#/$defs/canvas" },
    "runtime_scale": {
      "type": "object",
      "required": ["x", "y", "source"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "exclusiveMinimum": 0 },
        "y": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "safe_area": {
      "type": "object",
      "description": "Runtime safe-area geometry. bottom is retained as a compatibility alias; both bottom and footer_top_clearance mean the clearance from the canvas bottom to the top edge of the footer.",
      "required": ["left", "right", "top", "bottom", "footer_top_clearance", "bottom_semantics"],
      "additionalProperties": false,
      "properties": {
        "left": { "$ref": "#/$defs/nonNegative" },
        "right": { "$ref": "#/$defs/nonNegative" },
        "top": { "$ref": "#/$defs/nonNegative" },
        "bottom": {
          "$ref": "#/$defs/nonNegative",
          "description": "Compatibility alias for footer_top_clearance. It is the canvas-bottom clearance to the footer top edge, not the footer's bottom margin."
        },
        "footer_top_clearance": {
          "$ref": "#/$defs/nonNegative",
          "description": "Distance from the bottom of the runtime canvas to the footer top edge."
        },
        "bottom_semantics": { "const": "footer_top_clearance" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["columns", "gap", "gap_range", "unit", "coordinate_space", "layouts"],
      "additionalProperties": false,
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "gap": { "$ref": "#/$defs/positive" },
        "gap_range": { "$ref": "#/$defs/range" },
        "unit": { "const": "in" },
        "coordinate_space": { "const": "runtime" },
        "layouts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "spacing": {
      "type": "object",
      "required": [
        "unit", "coordinate_space", "base", "scale", "title_to_content",
        "block_gap", "card_padding", "card_padding_range", "card_gap", "grid_gap"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "in" },
        "coordinate_space": { "const": "runtime" },
        "base": { "$ref": "#/$defs/positive" },
        "scale": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/positive" } },
        "title_to_content": { "$ref": "#/$defs/positive" },
        "block_gap": { "$ref": "#/$defs/positive" },
        "card_padding": { "$ref": "#/$defs/positive" },
        "card_padding_range": { "$ref": "#/$defs/range" },
        "card_gap": { "$ref": "#/$defs/positive" },
        "grid_gap": { "$ref": "#/$defs/positive" }
      }
    },
    "density": {
      "type": "object",
      "required": [
        "max_top_level_bullets", "max_major_cards", "max_cjk_chars_per_card",
        "max_content_area_ratio", "max_major_charts", "max_supporting_conclusions",
        "max_typography_levels", "body_min_runtime_pt", "chart_min_runtime_pt"
      ],
      "additionalProperties": false,
      "properties": {
        "max_top_level_bullets": { "type": "integer", "minimum": 1 },
        "max_major_cards": { "type": "integer", "minimum": 1 },
        "max_cjk_chars_per_card": { "type": "integer", "minimum": 1 },
        "max_content_area_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_major_charts": { "type": "integer", "minimum": 1 },
        "max_supporting_conclusions": { "type": "integer", "minimum": 0 },
        "max_typography_levels": { "type": "integer", "minimum": 1 },
        "body_min_runtime_pt": { "$ref": "#/$defs/positive" },
        "chart_min_runtime_pt": { "$ref": "#/$defs/positive" }
      }
    },
    "components": { "$ref": "#/$defs/components" },
    "typography": { "$ref": "#/$defs/typography" },
    "fonts": {
      "type": "object",
      "required": ["header", "body", "fallback"],
      "additionalProperties": false,
      "properties": {
        "header": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "fallback": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "colors": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/color" } },
    "charts": {
      "type": "object",
      "required": [
        "allowed_types", "type_guidance", "min_font_size_pt",
        "max_donut_categories", "allow_3d", "anomaly_color", "required_metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "type_guidance": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "min_font_size_pt": { "$ref": "#/$defs/positive" },
        "max_donut_categories": { "type": "integer", "minimum": 1 },
        "allow_3d": { "type": "boolean" },
        "anomaly_color": { "type": "string", "minLength": 1 },
        "required_metadata": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "allowed_aspect_ratios", "crop_mode", "allow_stretch",
        "allow_upscale", "overlay_requires_mask", "same_page_consistency"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed_aspect_ratios": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } },
        "crop_mode": { "const": "fill" },
        "allow_stretch": { "type": "boolean" },
        "allow_upscale": { "type": "boolean" },
        "overlay_requires_mask": { "type": "boolean" },
        "same_page_consistency": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "bg_rules": {
      "type": "object",
      "required": ["title_bg", "content_bg", "use_title_bg", "use_content_bg"],
      "additionalProperties": false,
      "properties": {
        "title_bg": { "$ref": "#/$defs/assetPath" },
        "content_bg": { "$ref": "#/$defs/assetPath" },
        "use_title_bg": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "use_content_bg": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "footer": {
      "type": "object",
      "required": ["y", "height", "source_x", "source_width", "page_x", "page_width", "font_size", "color"],
      "additionalProperties": false,
      "properties": {
        "y": { "$ref": "#/$defs/nonNegative" },
        "height": { "$ref": "#/$defs/positive" },
        "source_x": { "$ref": "#/$defs/nonNegative" },
        "source_width": { "$ref": "#/$defs/positive" },
        "page_x": { "$ref": "#/$defs/nonNegative" },
        "page_width": { "$ref": "#/$defs/positive" },
        "font_size": { "$ref": "#/$defs/positive" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "slides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "nonNegative": { "type": "number", "minimum": 0 },
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/nonNegative" },
        "max": { "$ref": "#/$defs/positive" }
      }
    },
    "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
    "assetPath": { "type": "string", "pattern": "^assets/[^/]+$" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "units", "aspect_ratio"],
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/positive" },
        "height": { "$ref": "#/$defs/positive" },
        "units": { "const": "in" },
        "aspect_ratio": { "const": "16:9" },
        "note": { "type": "string" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["font_family", "line_spacing", "runtime_floor_pt", "design", "runtime", "ranges", "title_pt", "body_pt", "caption_pt", "minimum_readable_pt"],
      "additionalProperties": false,
      "properties": {
        "font_family": { "type": "string", "minLength": 1 },
        "line_spacing": { "type": "number", "minimum": 1, "maximum": 2 },
        "runtime_floor_pt": {
          "type": "object",
          "required": ["body", "chart", "caption"],
          "additionalProperties": false,
          "properties": {
            "body": { "$ref": "#/$defs/positive" },
            "chart": { "$ref": "#/$defs/positive" },
            "caption": { "$ref": "#/$defs/positive" }
          }
        },
        "design": { "$ref": "#/$defs/typeValues" },
        "runtime": { "$ref": "#/$defs/typeValues" },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cover_title_pt", "cover_subtitle_pt", "slide_title_pt", "long_title_pt", "conclusion_pt", "card_title_pt", "body_pt", "caption_pt", "label_pt", "key_number_pt", "chart_pt"],
          "properties": {
            "cover_title_pt": { "$ref": "#/$defs/typeRange" },
            "cover_subtitle_pt": { "$ref": "#/$defs/typeRange" },
            "slide_title_pt": { "$ref": "#/$defs/typeRange" },
            "long_title_pt": { "$ref": "#/$defs/typeRange" },
            "conclusion_pt": { "$ref": "#/$defs/typeRange" },
            "card_title_pt": { "$ref": "#/$defs/typeRange" },
            "body_pt": { "$ref": "#/$defs/typeRange" },
            "caption_pt": { "$ref": "#/$defs/typeRange" },
            "label_pt": { "$ref": "#/$defs/typeRange" },
            "key_number_pt": { "$ref": "#/$defs/typeRange" },
            "chart_pt": { "$ref": "#/$defs/typeRange" }
          }
        },
        "title_pt": { "$ref": "#/$defs/positive" },
        "body_pt": { "$ref": "#/$defs/positive" },
        "caption_pt": { "$ref": "#/$defs/positive" },
        "minimum_readable_pt": { "$ref": "#/$defs/positive" }
      }
    },
    "typeValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover_title_pt", "cover_subtitle_pt", "slide_title_pt", "long_title_pt", "conclusion_pt", "card_title_pt", "body_pt", "caption_pt", "label_pt", "key_number_pt", "chart_pt"],
      "properties": {
        "cover_title_pt": { "$ref": "#/$defs/positive" },
        "cover_subtitle_pt": { "$ref": "#/$defs/positive" },
        "slide_title_pt": { "$ref": "#/$defs/positive" },
        "long_title_pt": { "$ref": "#/$defs/positive" },
        "conclusion_pt": { "$ref": "#/$defs/positive" },
        "card_title_pt": { "$ref": "#/$defs/positive" },
        "body_pt": { "$ref": "#/$defs/positive" },
        "caption_pt": { "$ref": "#/$defs/positive" },
        "label_pt": { "$ref": "#/$defs/positive" },
        "key_number_pt": { "$ref": "#/$defs/positive" },
        "chart_pt": { "$ref": "#/$defs/positive" }
      }
    },
    "typeRange": {
      "type": "object",
      "required": ["design", "runtime"],
      "additionalProperties": false,
      "properties": {
        "design": { "$ref": "#/$defs/range" },
        "runtime": { "$ref": "#/$defs/range" }
      }
    },
    "components": {
      "type": "object",
      "required": ["corner_radius", "border", "shadow", "card", "pill", "structural"],
      "additionalProperties": false,
      "properties": {
        "corner_radius": {
          "type": "object",
          "required": ["unit", "reference_px", "min_in", "default_in", "max_in"],
          "additionalProperties": false,
          "properties": {
            "unit": { "const": "in" },
            "reference_px": {
              "type": "object",
              "required": ["min", "default", "max", "dpi"],
              "additionalProperties": false,
              "properties": {
                "min": { "$ref": "#/$defs/positive" },
                "default": { "$ref": "#/$defs/positive" },
                "max": { "$ref": "#/$defs/positive" },
                "dpi": { "const": 96 }
              }
            },
            "min_in": { "$ref": "#/$defs/positive" },
            "default_in": { "$ref": "#/$defs/positive" },
            "max_in": { "$ref": "#/$defs/positive" }
          }
        },
        "border": {
          "type": "object",
          "required": ["unit", "min_pt", "default_pt", "max_pt"],
          "additionalProperties": false,
          "properties": {
            "unit": { "const": "pt" },
            "min_pt": { "$ref": "#/$defs/positive" },
            "default_pt": { "$ref": "#/$defs/positive" },
            "max_pt": { "$ref": "#/$defs/positive" }
          }
        },
        "shadow": {
          "type": "object",
          "required": ["opacity", "blur_pt", "offset_x_in", "offset_y_in"],
          "additionalProperties": false,
          "properties": {
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "blur_pt": { "$ref": "#/$defs/nonNegative" },
            "offset_x_in": { "$ref": "#/$defs/nonNegative" },
            "offset_y_in": { "$ref": "#/$defs/nonNegative" }
          }
        },
        "card": { "$ref": "#/$defs/roundedComponent" },
        "pill": {
          "type": "object",
          "required": ["shape", "radius_rule", "use_for"],
          "additionalProperties": false,
          "properties": {
            "shape": { "const": "ROUNDED_RECTANGLE" },
            "radius_rule": { "type": "string", "minLength": 1 },
            "use_for": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "structural": {
          "type": "object",
          "required": ["shape", "use_for"],
          "additionalProperties": false,
          "properties": {
            "shape": { "const": "RECTANGLE" },
            "use_for": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "roundedComponent": {
      "type": "object",
      "required": ["shape", "radius_in", "border_pt", "use_for"],
      "additionalProperties": false,
      "properties": {
        "shape": { "const": "ROUNDED_RECTANGLE" },
        "radius_in": { "type": "number", "minimum": 0.104, "maximum": 0.167 },
        "border_pt": { "type": "number", "minimum": 0.75, "maximum": 1 },
        "use_for": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/nonNegative" },
        "y": { "$ref": "#/$defs/nonNegative" },
        "w": { "$ref": "#/$defs/positive" },
        "h": { "$ref": "#/$defs/positive" }
      }
    },
    "title": {
      "type": "object",
      "required": ["x", "y", "w", "h", "fontSize", "bold", "color", "align"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/nonNegative" },
        "y": { "$ref": "#/$defs/nonNegative" },
        "w": { "$ref": "#/$defs/positive" },
        "h": { "$ref": "#/$defs/positive" },
        "fontSize": { "$ref": "#/$defs/positive" },
        "bold": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "align": { "enum": ["left", "center", "right"] }
      }
    },
    "subtitle": {
      "type": "object",
      "required": ["x", "y", "w", "h", "fontSize", "color", "align"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/nonNegative" },
        "y": { "$ref": "#/$defs/nonNegative" },
        "w": { "$ref": "#/$defs/positive" },
        "h": { "$ref": "#/$defs/positive" },
        "fontSize": { "$ref": "#/$defs/positive" },
        "color": { "$ref": "#/$defs/color" },
        "align": { "enum": ["left", "center", "right"] }
      }
    },
    "slide": {
      "type": "object",
      "required": ["bg_image"],
      "additionalProperties": false,
      "properties": {
        "bg_image": { "$ref": "#/$defs/assetPath" },
        "title": { "$ref": "#/$defs/title" },
        "subtitle": { "$ref": "#/$defs/subtitle" },
        "metadata": { "$ref": "#/$defs/subtitle" },
        "content_area": { "$ref": "#/$defs/rect" }
      }
    }
  }
}
