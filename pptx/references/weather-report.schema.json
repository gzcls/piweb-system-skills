{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/weather-report.json",
  "title": "Seven-day weather report",
  "type": "object",
  "additionalProperties": false,
  "required": ["city", "retrievedAt", "source", "days"],
  "properties": {
    "city": { "type": "string", "minLength": 1, "maxLength": 40 },
    "reportTitle": { "type": "string", "minLength": 1, "maxLength": 80 },
    "reporter": { "type": "string", "minLength": 1, "maxLength": 40 },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "secondarySource": { "$ref": "#/$defs/source" },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/day" }
    },
    "alerts": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/alert" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "condition", "lowC", "highC"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "weekday": { "type": "string", "maxLength": 12 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 40 },
        "lowC": { "type": "number", "minimum": -60, "maximum": 60 },
        "highC": { "type": "number", "minimum": -60, "maximum": 60 },
        "wind": { "type": "string", "maxLength": 60 },
        "precipProbability": { "type": "number", "minimum": 0, "maximum": 100 },
        "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
        "uv": { "type": "string", "maxLength": 30 }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "sourceUrl"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  }
}
